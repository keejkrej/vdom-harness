{
  "name": "vdom-harness",
  "version": "0.1.0",
  "description": "A virtual DOM for agents: a society that observes itself and rewrites its graph, capabilities, and adapters.",
  "type": "module",
  "scripts": {
    "demo": "tsx src/demo.ts",
    "test": "tsx src/selftest.ts && tsx src/eval/tau2-selftest.ts",
    "build": "tsc --noEmit",
    "export": "tsx src/export-run.ts",
    "viz": "tsx src/serve.ts",
    "eval:tau2": "PYTHONPATH=python python3 -m tau2_vdom",
    "eval:tau2:smoke": "PYTHONPATH=python python3 -m tau2_vdom --domain mock --smoke",
    "eval:tau2:improve": "PYTHONPATH=python python3 -m tau2_vdom.improve --weight",
    "eval:tau2:obs": "PYTHONPATH=python python3 -m tau2_vdom.test_obs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
